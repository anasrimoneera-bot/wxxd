# --- required ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-app
# Long random string: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
# 32 random bytes, base64: python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Encrypts every store AppSecret. Back it up: losing it means re-entering all secrets.
SECRET_KEY_B64=
# Your server's fixed public IP (shown to users for the WeChat API IP whitelist)
SERVER_PUBLIC_IP=

# --- optional ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Set to false once you create customer accounts yourself
ALLOW_REGISTER=true
# Pause between products per worker (seconds), to stay under WeChat rate limits
WORKER_ITEM_INTERVAL_SECONDS=1
DATA_DIR=/data
# Host port the API listens on (127.0.0.1 only). Change it if another app on the server already uses 8000.
APP_PORT=8000
