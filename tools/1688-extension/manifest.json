{
  "manifest_version": 3,
  "name": "1688 货源助手",
  "version": "1.1.0",
  "description": "在 1688 网页上为微信小店助手里的商品找货源：AI 核对同款，读取每个规格的价格和运费，一键设为货源。",
  "permissions": ["storage", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "1688 货源助手" },
  "content_scripts": [
    { "matches": ["*://*.1688.com/*"], "js": ["parse.js", "content.js"], "css": ["content.css"], "run_at": "document_idle" }
  ]
}
