{
  "manifest_version": 3,
  "name": "1688 货源助手",
  "version": "2.15.5",
  "description": "在 1688 网页上为微信小店助手里的商品找货源：批量上传主图搜同款，手动选货源，读取每个规格的价格和运费，一键设为货源；下单时自动记录 1688 采购单号和实付，按 1688 物流自动发货；在微信小店后台商品列表读取曝光，先给曝光多的商品找货源。",
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "1688 货源助手"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.1688.com/*"
      ],
      "js": [
        "parse.js",
        "hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.1688.com/*"
      ],
      "js": [
        "parse.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.1688.com/*",
        "*://*.alibaba.com/*"
      ],
      "js": [
        "purchase.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "*://store.weixin.qq.com/*"
      ],
      "js": [
        "wxstore.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
